# ---------------------------------------------------------------------------
# Eccezioni: questi NON sono sonde usa e getta, sono il motore.
#
# Le regole larghe qui sopra (scripts/check-*.mjs, scripts/test-ocr*.mjs)
# stavano escludendo proprio i controlli che docs/HANDOFF-CODEX-PERFECT-SCAN.md
# cita come prova del motore, e i test dell'OCR. Il risultato: vivevano solo
# sul server, e quando Hetzner e' diventato irraggiungibile la loro unica copia
# era su un portatile. Un file che non e' in git non esiste il giorno che serve.
!scripts/check-html-home-policy.mjs
!scripts/check-identity-brand-host.mjs
!scripts/check-retry-strategy.mjs
!scripts/test-ocr.mjs
!scripts/test-ocr-contract.mjs
!scripts/test-ocr-smoke.mjs
!scripts/test-ocr-pdftoppm-resolver.mjs
!scripts/test-ocr-hybrid-policy-page.mjs
!scripts/test-ocr-policy-after-page-12.mjs

# ---------------------------------------------------------------------------
# Copie di staging morte: alberi dell'app duplicati per spedirli su Hetzner.
# Due contengono ancora accenti ricodificati due volte. Non sono il motore,
# sono fotocopie vecchie, e confonderebbero chi cerca la sorgente buona.
tmp-cert-*/
tmp-k3-*/
tmp-metrics-fix-ui/
tmp-sanita-*/
tmp-detector-from-git.ts

# 16 MB di schermate di collaudo. Il resto di tmp-v3-export/ e' l'esportazione
# del runtime dal server e va tenuta: e' l'unica unit systemd originale rimasta.
tmp-v3-export/ui-smoke/

# Copie di sicurezza dello script che ha riparato gli accenti.
*.mojibake.bak

# ---------------------------------------------------------------------------
# Schermate di collaudo: 104 PNG per 216 MB, cioe' quasi tutto il peso del
# repo per immagini che nessuno riapre. I verdetti dei collaudi stanno nei
# report.json accanto, e quelli restano.
data/**/*.png
docs/**/*.png
!docs/staging-acceptance/screenshots/.gitkeep

# Alberi di lavorazione temporanei: copie parziali dei sorgenti tenute per
# fare diff con il server. Il server non c'e' piu' e la sorgente buona e' src/.
tmp/

# ---------------------------------------------------------------------------
# Questi tre contengono una chiave API Anthropic scritta in chiaro. Non sono
# mai finiti in git — verificato con git log --all -S sul prefisso della chiave —
# e non ci devono finire: una chiave pubblicata su GitHub viene raccolta in
# minuti. La chiave che c'e' dentro va comunque revocata: e' in chiaro su disco.
tmp-set-ant-backend.py
tmp-test-ant.py
tmp-vercel-set-env.py

